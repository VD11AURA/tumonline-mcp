# Persönlicher TUMonline-Token (eigener Token pro Gerät).
# Anfordern mit: uv run tumonline-token <TUM-Kennung>, danach in TUMonline unter
# Visitenkarte -> Token-Management aktivieren.
TUMONLINE_TOKEN=
# Optional, leer = https://campus.tum.de/tumonline
TUMONLINE_BASE_URL=
# Optional: Moodle-Token ("Moodle mobile web service"), eintragen mit: uv run moodle-token
MOODLE_TOKEN=
# Optional, leer = https://www.moodle.tum.de
MOODLE_BASE_URL=
# Optional: Standard-Mensa für das mensa-Tool (IDs siehe Tool `mensen`), leer = mensa-garching
MENSA_DEFAULT=
